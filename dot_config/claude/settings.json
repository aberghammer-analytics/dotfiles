{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": false,
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(uv sync)",
      "Bash(ruff *)",
      "Bash(pnpm *)",
      "Bash(git *)"
    ],
    "ask": [
      "Bash(git -C *)",
      "Bash(git -c *)",
      "Bash(git --git-dir*)",
      "Bash(git --work-tree*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git * --force*)",
      "Bash(git * --hard*)",
      "Bash(git * --delete*)",
      "Bash(git * --mirror*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push -d*)",
      "Bash(git push * -d*)",
      "Bash(git push * +*)",
      "Bash(git push * :*)",
      "Bash(git push * --prune*)",
      "Bash(git clean *)",
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git branch -f*)",
      "Bash(git branch * -f*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git checkout .)",
      "Bash(git checkout -f*)",
      "Bash(git checkout * -f*)",
      "Bash(git switch --discard-changes*)",
      "Bash(git switch * --discard-changes*)",
      "Bash(git switch -f*)",
      "Bash(git switch * -f*)",
      "Bash(git restore *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(git reflog expire*)",
      "Bash(git reflog delete*)",
      "Bash(git gc *--prune*)",
      "Bash(git prune *)",
      "Bash(git update-ref *)",
      "Bash(git tag -d*)",
      "Bash(git tag * -d*)",
      "Bash(git tag -f*)",
      "Bash(git tag * -f*)"
    ]
  }
}
