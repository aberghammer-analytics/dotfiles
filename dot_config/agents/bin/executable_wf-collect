#!/usr/bin/env bash
# wf-collect <id> — grade a finished worker OR close a checkpoint.
# The ONLY writer of: verify results, ledger lines, done/ready/parked flips, commits.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/wf-env"

id="$1"
file="$(python3 "$WF_LIB" file-of "$id")"
path=".claude/issues/$file"
typ="$(python3 "$WF_LIB" get "$path" type)"
verify="$(python3 "$WF_LIB" get "$path" verify)"
run_id="${WF_RUN_ID:-$(date +%Y-%m-%d)}"

ledger() { # ATTEMPT RESULT DURATION COST VEXIT INTERVENTION
  printf '{"ts":"%s","run_id":"%s","issue":"%s","attempt":%s,"result":"%s","duration_s":%s,"cost_usd":%s,"verify_exit":%s,"intervention":"%s"}\n' \
    "$(date -u +%FT%TZ)" "$run_id" "$id" "$1" "$2" "$3" "$4" "$5" "$6" >> "$WF_LEDGER"
}

# ---- checkpoints: run verify, close on pass ---------------------------------
if [[ "$typ" == "checkpoint" ]]; then
  if bash -c "${verify:-true}"; then
    python3 "$WF_LIB" set "$path" status done
    git add -A && git commit -qm "wf: checkpoint $id" || true
    ledger 1 pass 0 0 0 ""
    echo "wf-collect: checkpoint $id closed"
  else
    ledger 1 fail 0 0 1 ""
    echo "wf-collect: checkpoint $id verify FAILED"; exit 1
  fi
  exit 0
fi

# ---- tasks: grade the worker ------------------------------------------------
rec="$WF_RUNNING/$id.json"
attempt=1; intervention=""; log=""; started=""
if [[ -f "$rec" ]]; then
  attempt="$(python3 -c "import json;print(json.load(open('$rec'))['attempt'])")"
  intervention="$(python3 -c "import json;print(json.load(open('$rec'))['intervention'])")"
  log="$(python3 -c "import json;print(json.load(open('$rec'))['log'])")"
  started="$(python3 -c "import json;print(json.load(open('$rec'))['started'])")"
  pid="$(python3 -c "import json;print(json.load(open('$rec'))['pid'])")"
  kill -0 "$pid" 2>/dev/null && { echo "wf-collect: $id still running (pid $pid)"; exit 2; }
fi

duration=0
[[ -n "$started" ]] && duration=$(( $(date +%s) - $(date -d "$started" +%s 2>/dev/null || echo $(date +%s)) ))
cost=0
[[ -f "$log" ]] && cost="$(python3 - "$log" <<'EOF'
import sys, json
try:
    for line in reversed(open(sys.argv[1]).read().splitlines()):
        line = line.strip()
        if line.startswith("{"):
            print(json.loads(line).get("total_cost_usd", 0)); break
    else: print(0)
except Exception: print(0)
EOF
)"

if bash -c "$verify" >> "${log:-/dev/null}" 2>&1; then
  python3 "$WF_LIB" set "$path" status done
  git add -A && git commit -qm "wf: complete issue $id" || true
  ledger "$attempt" pass "$duration" "$cost" 0 "$intervention"
  rm -f "$rec"
  echo "wf-collect: $id PASS (attempt $attempt, ${duration}s, \$$cost)"
else
  max="$(python3 "$WF_LIB" get "$path" max_attempts)"
  if (( attempt >= max )); then
    python3 "$WF_LIB" set "$path" status parked
    ledger "$attempt" fail "$duration" "$cost" 1 "$intervention"
    rm -f "$rec"
    echo "wf-collect: $id FAIL — PARKED after $attempt attempts (see $log)"; exit 1
  else
    python3 "$WF_LIB" set "$path" status ready
    ledger "$attempt" fail "$duration" "$cost" 1 "$intervention"
    rm -f "$rec"
    echo "wf-collect: $id FAIL (attempt $attempt/$max) — back to ready (see $log)"; exit 1
  fi
fi
