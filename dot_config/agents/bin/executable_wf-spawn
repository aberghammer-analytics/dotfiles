#!/usr/bin/env bash
# wf-spawn <id> [--hint "text"] — launch one headless worker for a task ticket.
# Bumps attempts, sets in_progress, writes .claude/running/<id>.json.
# Checkpoints are never spawned — they're closed by wf-collect or /review.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/wf-env"

id="$1"; shift
hint=""
[[ "${1:-}" == "--hint" ]] && hint="$2"

file="$(python3 "$WF_LIB" file-of "$id")"
path=".claude/issues/$file"
[[ "$(python3 "$WF_LIB" get "$path" type)" == "task" ]] || { echo "wf-spawn: $id is a checkpoint"; exit 2; }

attempt="$(python3 "$WF_LIB" bump-attempts "$path")"
max="$(python3 "$WF_LIB" get "$path" max_attempts)"
(( attempt <= max )) || { python3 "$WF_LIB" set "$path" status parked; echo "wf-spawn: $id exceeds max_attempts — parked"; exit 3; }
python3 "$WF_LIB" set "$path" status in_progress

mkdir -p "$WF_RUNNING" "$WF_LOGS"
log="$WF_LOGS/${id}-attempt${attempt}.log"

# Prompt: project override beats global template; hint appended if present.
tmpl=".claude/ticket-prompt.md"
[[ -f "$tmpl" ]] || tmpl="$WF_HERE/../templates/ticket-prompt.md"
prompt="$(sed -e "s|{{ISSUE_FILE}}|$path|g" "$tmpl")"
[[ -n "$hint" ]] && prompt+=$'\n\nORCHESTRATOR HINT (from a prior failed attempt):\n'"$hint"

worker_cmd=("$WF_CLAUDE_BIN" -p "$prompt")
read -r -a extra_flags <<< "$WF_CLAUDE_FLAGS"

case "$WF_SPAWN_MODE" in
  herdr)
    # Run the worker in a visible herdr pane; the pane hosts the same headless
    # process. Requires herdr CLI; falls back to background if absent.
    if command -v herdr >/dev/null 2>&1; then
      herdr run --name "wf-$id" -- bash -c \
        "$(printf '%q ' "${worker_cmd[@]}" "${extra_flags[@]}") 2>&1 | tee $(printf '%q' "$log")" &
      pid=$!
    else
      echo "wf-spawn: herdr not found; using background mode" >&2
      nohup bash -c "$(printf '%q ' "${worker_cmd[@]}" "${extra_flags[@]}") > $(printf '%q' "$log") 2>&1" >/dev/null 2>&1 &
      pid=$!
    fi ;;
  background|*)
    nohup bash -c "$(printf '%q ' "${worker_cmd[@]}" "${extra_flags[@]}") > $(printf '%q' "$log") 2>&1" >/dev/null 2>&1 &
    pid=$! ;;
esac

python3 - "$id" "$pid" "$attempt" "$log" "$path" "$hint" <<'EOF'
import json, sys, time
id, pid, attempt, log, path, hint = sys.argv[1:7]
sys.path.insert(0, __import__('os').environ['WF_LIB'].rsplit('/',1)[0])
import importlib.util
spec = importlib.util.spec_from_file_location("wflib", __import__('os').environ['WF_LIB'])
wl = importlib.util.module_from_spec(spec); spec.loader.exec_module(wl)
fm = wl.parse_frontmatter(__import__('pathlib').Path(path))
rec = {"id": id, "pid": int(pid), "attempt": int(attempt), "log": log,
       "files": fm.get("files", []), "verify": fm.get("verify", ""),
       "intervention": "retry-with-hint" if hint else "",
       "started": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
open(f".claude/running/{id}.json", "w").write(json.dumps(rec))
EOF

echo "wf-spawn: $id attempt $attempt/$max pid $pid log $log${hint:+ (with hint)}"
