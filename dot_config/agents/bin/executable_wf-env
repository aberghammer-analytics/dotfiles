#!/usr/bin/env bash
# wf-env — shared config for the toolbelt. Source, don't execute.
export WF_CLAUDE_BIN="${WF_CLAUDE_BIN:-claude}"
export WF_CLAUDE_FLAGS="${WF_CLAUDE_FLAGS:---dangerously-skip-permissions --output-format json}"
export WF_SPAWN_MODE="${WF_SPAWN_MODE:-background}" # herdr | background
export WF_CAP="${WF_CAP:-1}"
export WF_STALL_SECS="${WF_STALL_SECS:-600}"
WF_HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
export WF_LIB="$WF_HERE/wf-lib.py"
export WF_RUNNING=".claude/running"
export WF_LOGS=".claude/logs"
export WF_LEDGER=".claude/ledger.jsonl"

wf_running_footprints() { # comma-joined files globs of all live workers
  local out=""
  for j in "$WF_RUNNING"/*.json; do
    [[ -e "$j" ]] || continue
    out+=$(python3 -c "import json;print(','.join(json.load(open('$j')).get('files',[])))"),
  done
  echo "${out%,}"
}
