#!/usr/bin/env bash
# wf-status — DAG state + ledger rollup for the current project.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "== issues =="
python3 "$HERE/wf-lib.py" summary

if [[ -f .claude/run.lock ]]; then
  pid="$(cat .claude/run.lock)"
  if kill -0 "$pid" 2>/dev/null; then echo -e "\n== run: ACTIVE (pid $pid) =="
  else echo -e "\n== run: STALE LOCK (pid $pid is dead — remove .claude/run.lock) =="; fi
else
  echo -e "\n== run: idle =="
fi

if [[ -f .claude/ledger.jsonl ]]; then
  echo -e "\n== ledger rollup =="
  python3 - <<'EOF'
import json
lines = [json.loads(l) for l in open(".claude/ledger.jsonl") if l.strip()]
cost = sum(float(l.get("cost_usd", 0)) for l in lines)
secs = sum(int(l.get("duration_s", 0)) for l in lines)
fails = sum(1 for l in lines if l.get("result") != "pass")
print(f"attempts: {len(lines)}   failures: {fails}   wall: {secs//60}m   cost: ${cost:.2f}")
EOF
fi
