#!/usr/bin/env bash
# wf-loop — headless rump runner over the primitives. Sequential, fire-and-forget.
# Also the completeness check: if this can't run the DAG alone, invariants have
# leaked into the send-it skill.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/wf-env"
LOCK=".claude/run.lock"
export WF_RUN_ID="$(date +%Y-%m-%d)-$RANDOM"

python3 "$WF_LIB" check-schema
[[ -f "$LOCK" ]] && { echo "wf-loop: lock exists (pid $(cat "$LOCK")) — active or stale run"; exit 1; }
echo $$ > "$LOCK"; trap 'rm -f "$LOCK"' EXIT

# reconcile orphans from a previous run
for j in "$WF_RUNNING"/*.json; do
  [[ -e "$j" ]] || continue
  id="$(python3 -c "import json;print(json.load(open('$j'))['id'])")"
  "$WF_HERE/wf-collect" "$id" || true
done

while true; do
  reason="$("$WF_HERE/wf-wait")"
  case "$reason" in
    dispatch-ready)
      "$WF_HERE/wf-next" | head -n "$WF_CAP" | while IFS=$'\t' read -r id typ _; do
        [[ "$typ" == "task" ]] && "$WF_HERE/wf-spawn" "$id"
      done ;;
    ticket-exit\ *)      "$WF_HERE/wf-collect" "${reason#ticket-exit }" || {
                           # parked → halt loudly; transient fail → loop respawns
                           grep -q parked <<< "$(python3 "$WF_LIB" summary)" && exit 1; } ;;
    stalled\ *)          echo "wf-loop: ${reason} — killing and collecting"
                         id="${reason#stalled }"
                         pid="$(python3 -c "import json;print(json.load(open('$WF_RUNNING/$id.json'))['pid'])")"
                         kill "$pid" 2>/dev/null || true; sleep 1
                         "$WF_HERE/wf-collect" "$id" || true ;;
    checkpoint-ready\ *) id="${reason#checkpoint-ready }"
                         file="$(python3 "$WF_LIB" file-of "$id")"
                         if [[ "$(python3 "$WF_LIB" get ".claude/issues/$file" auto_close)" == "true" ]]; then
                           "$WF_HERE/wf-collect" "$id" || { echo "wf-loop: HALT — checkpoint $id review failed"; exit 1; }
                         else
                           echo "wf-loop: HALT — checkpoint $id awaits human review (/review)"; exit 0
                         fi ;;
    blocked)             echo "wf-loop: HALT — nothing runnable (parked dependencies?)"
                         python3 "$WF_LIB" summary; exit 1 ;;
    run-done)            echo "wf-loop: run complete"; python3 "$WF_LIB" summary; exit 0 ;;
  esac
done
